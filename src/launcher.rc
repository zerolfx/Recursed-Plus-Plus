#include <winver.h>

/* CREATEPROCESS_MANIFEST_RESOURCE_ID, RT_MANIFEST */
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Recursed++ launcher"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "Recursed-Plus-Plus"
            VALUE "OriginalFilename","Recursed-Plus-Plus.exe"
            VALUE "ProductName",     "Recursed++"
            VALUE "ProductVersion",  "1.0.0.0"
            VALUE "Comments",        "Starts Recursed with the room inspection mod loaded. Not affiliated with the game's authors."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
