#include <winver.h>

/* CREATEPROCESS_MANIFEST_RESOURCE_ID, RT_MANIFEST */
1 24 "launcher.manifest"

/* The mod itself, carried inside the launcher so that a player downloads one file. The path is
   relative to this script, and the build compiles the DLL before it compiles these resources. */
RECURSEDPEEKPLUGIN RCDATA "..\\build\\recursed_peek.dll"

/* Lua ships under a licence that requires its notice to accompany every copy of the software.
   The single executable is the copy, so the notice travels inside it and the launcher shows it. */
RECURSEDPEEKNOTICES RCDATA "..\\THIRD_PARTY_NOTICES.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,1,0
 PRODUCTVERSION 1,5,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Recursed++ launcher"
            VALUE "FileVersion",     "1.5.1.0"
            VALUE "InternalName",    "Recursed-Plus-Plus"
            VALUE "OriginalFilename","Recursed-Plus-Plus.exe"
            VALUE "ProductName",     "Recursed++"
            VALUE "ProductVersion",  "1.5.1.0"
            VALUE "Comments",        "Starts Recursed with the room inspection mod loaded. Not affiliated with the game's authors."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
